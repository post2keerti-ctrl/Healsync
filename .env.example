# Copy to .env and fill in real values. Every line below is OPTIONAL —
# anything left blank automatically falls back to a local dev stand-in
# (see app/config.py), so the app runs immediately even with none of this set.

# ---- MongoDB Atlas ----
# Get this from Atlas -> Connect -> Drivers. Include the database user's password.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=healsync

# ---- Firebase Authentication ----
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# Mount/copy that JSON file into the container and point this at its path.
FIREBASE_CREDENTIALS_PATH=/app/firebase-service-account.json
# Firebase Console -> Project settings -> Your apps -> Web app configuration.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=

# ---- Google Maps ----
# Google Cloud Console -> APIs & Services -> Credentials. Enable "Distance Matrix API".
GOOGLE_MAPS_API_KEY=

# ---- Llama 3 ----
# Point at a self-hosted Ollama server (or any OpenAI/Ollama-compatible endpoint).
LLAMA_BASE_URL=
LLAMA_MODEL=llama3

# ---- scispaCy clinical model (optional upgrade over the rule-based fallback) ----
SCISPACY_MODEL_NAME=en_core_sci_sm
