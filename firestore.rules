rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.firebase_uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.firebase_uid;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.firebase_uid
        && request.resource.data.role == resource.data.role;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
